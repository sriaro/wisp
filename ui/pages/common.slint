import { Theme } from "../theme.slint";
import { Icon, Sq } from "../widgets.slint";
import { Rise } from "../motion.slint";

export component PageFrame inherits Rectangle {
    in property <bool> current: false;
    x: 0px;
    y: current ? Theme.glide(1 - Theme.page-a, 13px) : 0px;
    width: 100%;
    height: 100%;
    visible: current;
    @children
}

export component PageHead inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 5px;
    Text {
        opacity: Theme.page-a;
        text: root.title;
        color: Theme.text;
        font-size: 25.5px;
        font-weight: 700;
    }
    Text {
        text: root.sub;
        color: Theme.text-dim.transparentize(1 - Theme.page-a);
        font-size: 12px;
        wrap: word-wrap;
    }
}

export component EmptyState inherits Rise {
    in property <string> icon;
    in property <string> title;
    in property <string> sub;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        Rectangle {
            height: 57.5px;
            Rectangle {
                width: 57.5px;
                height: 57.5px;
                Sq {
                    r: 17.5;
                    colorize: Theme.accent-soft.transparentize(1 - root.v);
                }
                Icon {
                    opacity: root.v;
                    kind: root.icon;
                    size: 27px;
                    colorize: Theme.accent;
                }
            }
        }
        Text {
            opacity: root.v;
            text: root.title;
            color: Theme.text;
            font-size: 15.5px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            opacity: root.v;
            text: root.sub;
            color: Theme.text-dim;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
