import { Theme, AppState } from "theme.slint";

component TitleButton inherits Rectangle {
    in property <bool> danger: false;
    in property <string> glyph;
    callback clicked;
    width: 46px;
    background: ta.pressed ? (danger ? #c42b1ce6 : Theme.hover) : (ta.has-hover ? (danger ? #c42b1c : Theme.hover) : transparent);
    animate background { duration: 90ms; }
    Text {
        text: root.glyph;
        font-family: "Segoe Fluent Icons";
        font-size: 10px;
        color: root.danger && ta.has-hover ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component TitleBar inherits Rectangle {
    height: 32px;

    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                AppState.window-drag();
            }
        }
        double-clicked => {
            AppState.window-maximize();
        }
    }

    HorizontalLayout {
        alignment: end;

        TitleButton {
            glyph: "\u{E921}";
            clicked => {
                AppState.window-minimize();
            }
        }

        TitleButton {
            glyph: AppState.maximized ? "\u{E923}" : "\u{E922}";
            clicked => {
                AppState.window-maximize();
            }
        }

        TitleButton {
            danger: true;
            glyph: "\u{E8BB}";
            clicked => {
                AppState.window-close();
            }
        }
    }
}

component Edge inherits TouchArea {
    in property <int> direction;
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left && !AppState.maximized) {
            AppState.window-resize(root.direction);
        }
    }
}

export component ResizeEdges inherits Rectangle {
    Edge {
        direction: 0;
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: 4px;
        mouse-cursor: AppState.maximized ? default : ns-resize;
    }
    Edge {
        direction: 1;
        x: 8px;
        y: parent.height - 4px;
        width: parent.width - 16px;
        height: 4px;
        mouse-cursor: AppState.maximized ? default : ns-resize;
    }
    Edge {
        direction: 2;
        x: 0px;
        y: 8px;
        width: 4px;
        height: parent.height - 16px;
        mouse-cursor: AppState.maximized ? default : ew-resize;
    }
    Edge {
        direction: 3;
        x: parent.width - 4px;
        y: 8px;
        width: 4px;
        height: parent.height - 16px;
        mouse-cursor: AppState.maximized ? default : ew-resize;
    }
    Edge {
        direction: 4;
        x: 0px;
        y: 0px;
        width: 8px;
        height: 8px;
        mouse-cursor: AppState.maximized ? default : nwse-resize;
    }
    Edge {
        direction: 5;
        x: parent.width - 8px;
        y: 0px;
        width: 8px;
        height: 8px;
        mouse-cursor: AppState.maximized ? default : nesw-resize;
    }
    Edge {
        direction: 6;
        x: 0px;
        y: parent.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: AppState.maximized ? default : nesw-resize;
    }
    Edge {
        direction: 7;
        x: parent.width - 8px;
        y: parent.height - 8px;
        width: 8px;
        height: 8px;
        mouse-cursor: AppState.maximized ? default : nwse-resize;
    }
}
