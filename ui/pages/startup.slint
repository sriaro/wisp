import { Theme, T, AppState, StartItem } from "../theme.slint";
import { Glass, Chip, Pill, SecondaryButton, IconButton, Toggle, ListGroup, ProgressStrip, SegTabs } from "../widgets.slint";
import { PageFrame, PageHead, EmptyState } from "common.slint";
import { Intro, Rise } from "../motion.slint";

component StartRow inherits Rise {
    in property <StartItem> item;
    in property <bool> last: false;
    in property <bool> shown: true;
    callback toggled(bool);
    callback removed;
    height: 58px;
    visible: shown;

    if !root.last: Rectangle {
        x: 68px;
        y: parent.height - 1px;
        width: parent.width - 68px - 14px;
        height: 1px;
        background: Theme.sep.transparentize(1 - root.v);
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 13px;
        spacing: 13px;
        Chip {
            fade: root.v;
            icon: root.item.icon;
            tint: root.item.tint;
            size: 37px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                opacity: root.v;
                text: root.item.name;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: Theme.semi;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                min-width: 0px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3.5px;
                    background: (root.item.tone == 0 ? Theme.ok : root.item.tone == 1 ? Theme.warn : Theme.danger).transparentize(1 - root.v);
                }
                Text {
                    opacity: root.v;
                    text: root.item.tag;
                    color: root.item.tone == 0 ? Theme.ok : root.item.tone == 1 ? Theme.warn : Theme.danger;
                    font-size: 11px;
                    font-weight: Theme.semi;
                    vertical-alignment: center;
                }
                Text {
                    opacity: root.v;
                    text: root.item.publisher != "" ? root.item.publisher + "  ·  " + root.item.command : root.item.command;
                    color: Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
            }
        }
        if root.item.missing: Pill {
            fade: root.v;
            text: T.s("badge.missing");
            fg: Theme.danger;
            bg: Theme.danger-soft;
            y: (parent.height - self.height) / 2;
        }
        if root.item.system: Pill {
            fade: root.v;
            text: T.s("badge.system");
            fg: Theme.text-dim;
            bg: Theme.hover;
            y: (parent.height - self.height) / 2;
        }
        if root.item.admin: Pill {
            fade: root.v;
            text: T.s("badge.admin");
            fg: Theme.warn;
            bg: Theme.warn-soft;
            y: (parent.height - self.height) / 2;
        }
        Pill {
            fade: root.v;
            text: root.item.kind-name;
            fg: Theme.tint-fg(7);
            bg: Theme.tint-bg(7);
            y: (parent.height - self.height) / 2;
        }
        Toggle {
            fade: root.v;
            on: root.item.enabled;
            enabled: root.item.can-toggle;
            y: (parent.height - self.height) / 2;
            toggled(v) => {
                root.toggled(v);
            }
        }
        IconButton {
            fade: root.v;
            icon: "trash";
            danger: true;
            enabled: root.item.can-delete;
            y: (parent.height - self.height) / 2;
            clicked => {
                root.removed();
            }
        }
    }
}

export component StartupPage inherits PageFrame {
    VerticalLayout {
        spacing: 14.5px;
        PageHead {
            title: T.s("start.title");
            sub: AppState.start-sub;
        }
        SegTabs {
            names: AppState.start-tab-names;
            current: AppState.start-tab;
            selected(i) => {
                AppState.select-start-tab(i);
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if AppState.startups.length > 0: lg := ListGroup {
                limit: parent.height;
                width: parent.width;
                for item[i] in AppState.startups: StartRow {
                    order: i;
                    shown: self.absolute-position.y + self.height > lg.absolute-position.y && self.absolute-position.y < lg.absolute-position.y + lg.height;
                    item: item;
                    last: i == AppState.startups.length - 1;
                    toggled(v) => {
                        AppState.toggle-start(item.idx, v);
                    }
                    removed => {
                        AppState.delete-start(item.idx);
                    }
                }
            }
            if AppState.startups.length == 0: EmptyState {
                icon: "power";
                title: T.s("start.empty");
                sub: AppState.start-sub;
            }
        }
        Glass {
            height: 57.5px;
            radius: 17.5px;
            strong: true;
            HorizontalLayout {
                padding-left: 21px;
                padding-right: 11px;
                spacing: 9.5px;
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    Text {
                        opacity: Theme.page-a;
                        text: AppState.busy ? AppState.status : AppState.start-count-text;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: Theme.semi;
                        overflow: elide;
                    }
                    ProgressStrip {
                        active: AppState.busy;
                    }
                }
                Text {
                    opacity: Theme.page-a;
                    text: T.s("start.showsys");
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Toggle {
                    on: AppState.start-show-system;
                    y: (parent.height - self.height) / 2;
                    toggled(v) => {
                        AppState.set-show-system(v);
                    }
                }
                SecondaryButton {
                    text: T.s("btn.refresh");
                    icon: "refresh";
                    enabled: !AppState.busy;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        AppState.refresh-start();
                    }
                }
            }
        }
    }
}
