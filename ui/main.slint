import { Theme, T, Geo, AppState, CatItem, IssueItem, StartItem, DetailRow } from "theme.slint";
import { Icon, Chip, Glass, Sq, PrimaryButton, SecondaryButton, IconButton, Scroller, SoftShadow } from "widgets.slint";
import { HomePage } from "pages/home.slint";
import { CleanPage } from "pages/clean.slint";
import { RegistryPage } from "pages/registry.slint";
import { StartupPage } from "pages/startup.slint";
import { UninstallPage, UninstallState, ProgItem } from "pages/uninstall.slint";
import { DiskPage, DiskState, TileItem, DiskRow, LegendItem } from "pages/disk.slint";
import { ToolsPage, ToolsState, ToolItem } from "pages/tools.slint";
import { BackupsPage, BackupsState, DataItem } from "pages/backups.slint";
import { TitleBar, ResizeEdges } from "titlebar.slint";
import { Intro, Rise } from "motion.slint";

export { Theme, T, Geo, AppState, CatItem, IssueItem, StartItem, DetailRow, UninstallState, ProgItem, DiskState, TileItem, DiskRow, LegendItem, ToolsState, ToolItem, BackupsState, DataItem }

component DetailLine inherits Rise {
    paged: false;
    in property <DetailRow> item;
    in property <bool> shown: true;
    height: 60px;
    visible: shown;

    Rectangle {
        y: 3px;
        height: parent.height - 6px;
        border-radius: 14px;
        background: ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 140ms; }
        Rectangle {
            x: 0px;
            width: parent.width * root.item.share;
            visible: root.item.share >= 0.03;
            border-radius: 14px;
            background: Theme.tint-fg(root.item.share > 0.5 ? 3 : root.item.tint).with-alpha(0.11 * root.v);
        }
    }
    ta := TouchArea {}

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 13px;
        Chip {
            fade: root.v;
            icon: root.item.icon;
            tint: root.item.tint;
            size: 36px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                opacity: root.v;
                text: root.item.name;
                color: Theme.text;
                font-size: 13px;
                font-weight: Theme.semi;
                overflow: elide;
            }
            Text {
                opacity: root.v;
                text: root.item.place;
                color: Theme.text-dim;
                font-size: 11px;
                overflow: elide;
            }
        }
        if root.item.percent != "": Text {
            opacity: root.v;
            text: root.item.percent;
            color: Theme.text-dim;
            font-size: 11px;
            font-weight: Theme.semi;
            width: 34px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            width: 80px;
            Text {
                opacity: root.v;
                text: root.item.size;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: right;
            }
            Text {
                opacity: root.v;
                text: root.item.count;
                color: Theme.text-dim;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
        IconButton {
            fade: root.v;
            icon: "folder";
            size: 32px;
            visible: root.item.path != "";
            y: (parent.height - self.height) / 2;
            clicked => {
                AppState.open-location(root.item.path);
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active: false;
    callback clicked;
    height: 37px;

    property <float> hover-a: ta.has-hover && !root.active ? 1 : 0;
    property <float> active-a: root.active ? 1 : 0;
    animate hover-a { duration: 160ms; }
    animate active-a { duration: 200ms; }

    Sq {
        r: 9.5;
        colorize: Theme.hover;
        fade: root.hover-a;
        visible: root.hover-a > 0.001;
    }

    Sq {
        r: 9.5;
        colorize: Theme.nav-active;
        fade: root.active-a;
        visible: root.active-a > 0.001;
    }

    Rectangle {
        x: 0px;
        width: 3px;
        height: root.active ? 19px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 300ms; easing: spring(0.15); }
    }

    HorizontalLayout {
        padding-left: 16px;
        spacing: 11px;
        Icon {
            kind: root.icon;
            size: 17px;
            colorize: root.active ? Theme.accent : Theme.text-dim;
            y: (parent.height - self.height) / 2;
            animate colorize { duration: Theme.quiet ? 0ms : 180ms; }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.text-dim;
            font-size: 13px;
            font-weight: Theme.semi;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Backdrop inherits Rectangle {
    in property <bool> veil: false;
    width: 100%;
    height: 100%;
    background: !root.veil && AppState.glass-active ? Theme.glass-tint : Theme.bg-gradient;
    clip: true;

    Rectangle {
        x: -240px;
        y: -260px;
        width: 720px;
        height: 720px;
        background: Theme.blob-a;
    }
    Rectangle {
        x: parent.width - 480px;
        y: parent.height - 440px;
        width: 720px;
        height: 720px;
        background: Theme.blob-b;
    }
    Rectangle {
        x: parent.width - 520px;
        y: -320px;
        width: 640px;
        height: 640px;
        background: Theme.blob-c;
    }
}

export component MainWindow inherits Window {
    title: "Wisp";
    no-frame: true;
    icon: @image-url("../assets/app-256.png");
    default-font-family: Theme.ui-font;
    min-width: 820px;
    min-height: 560px;
    preferred-width: 1080px;
    preferred-height: 740px;
    background: AppState.glass-enabled ? transparent : Theme.bg-base;
    property <float> veil: Theme.veil-target;
    animate veil { duration: Theme.veil-ms * 1ms; easing: spring(0); }
    changed veil => {
        Theme.page-a = 1 - self.veil;
    }
    property <int> target-page: AppState.page;
    changed target-page => {
        AppState.page-moved(self.target-page);
    }
    changed width => {
        AppState.window-changed();
    }

    Backdrop {}

    Rectangle {
        width: 100%;
        height: 100%;

    Glass {
        fade: 1;
        x: 11px;
        y: 30.5px;
        width: 198.5px;
        height: parent.height - 30.5px - 11px;
        radius: 24px;

        VerticalLayout {
            padding: 14.5px;
            spacing: 3px;

            HorizontalLayout {
                spacing: 10px;
                padding-left: 6px;
                padding-top: 6px;
                padding-bottom: 10px;
                Image {
                    source: @image-url("../assets/app-256.png");
                    width: 34px;
                    height: 34px;
                    image-fit: contain;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: "Wisp";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 700;
                    }
                    Text {
                        text: T.s("app.tag");
                        color: Theme.text-dim;
                        font-size: 11px;
                    }
                }
            }

            NavItem {
                icon: "sparkles";
                text: T.s("nav.home");
                active: AppState.page == 0;
                clicked => {
                    AppState.page = 0;
                }
            }
            NavItem {
                icon: "trash";
                text: T.s("nav.clean");
                active: AppState.page == 1;
                clicked => {
                    AppState.page = 1;
                }
            }
            NavItem {
                icon: "grid";
                text: T.s("nav.disk");
                active: AppState.page == 5;
                clicked => {
                    AppState.page = 5;
                }
            }
            NavItem {
                icon: "box";
                text: T.s("nav.uninstall");
                active: AppState.page == 4;
                clicked => {
                    AppState.page = 4;
                }
            }
            NavItem {
                icon: "power";
                text: T.s("nav.startup");
                active: AppState.page == 3;
                clicked => {
                    AppState.page = 3;
                }
            }
            NavItem {
                icon: "database";
                text: T.s("nav.registry");
                active: AppState.page == 2;
                clicked => {
                    AppState.page = 2;
                }
            }
            NavItem {
                icon: "wrench";
                text: T.s("nav.tools");
                active: AppState.page == 6;
                clicked => {
                    AppState.page = 6;
                }
            }

            NavItem {
                icon: "archive";
                text: T.s("nav.backups");
                active: AppState.page == 7;
                clicked => {
                    AppState.page = 7;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            Rectangle {
                Sq {
                    r: 14.5;
                    colorize: Theme.chip-bg;
                    edge: Theme.card-border;
                    edge-width: 1px;
                }
                VerticalLayout {
                    padding: 11px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Icon {
                            kind: AppState.is-admin ? "shield" : "shield-alert";
                            size: 17.5px;
                            colorize: AppState.is-admin ? Theme.ok : Theme.warn;
                            y: 1px;
                        }
                        Text {
                            text: AppState.is-admin ? T.s("admin.yes") : T.s("admin.no");
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: Theme.semi;
                            vertical-alignment: center;
                        }
                    }
                    if !AppState.is-admin: Text {
                        text: T.s("admin.hint");
                        color: Theme.text-dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    if !AppState.is-admin: SecondaryButton {
                        fade: 1;
                        text: T.s("btn.admin");
                        height: 32px;
                        clicked => {
                            AppState.restart-admin();
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                padding-top: 5px;
                Rectangle {
                    width: 33.5px;
                    height: 33.5px;
                    border-radius: 17px;
                    background: Theme.chip-bg;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    Rectangle {
                        border-radius: 17px;
                        background: theme-ta.has-hover ? Theme.hover : transparent;
                    }
                    Icon {
                        kind: Theme.dark ? "sun" : "moon";
                        size: 16px;
                        colorize: Theme.text;
                    }
                    theme-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.toggle-theme();
                        }
                    }
                }
                Rectangle {
                    width: 33.5px;
                    height: 33.5px;
                    border-radius: 17px;
                    background: Theme.chip-bg;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    Rectangle {
                        border-radius: 17px;
                        background: lang-ta.has-hover ? Theme.hover : transparent;
                    }
                    Text {
                        text: T.s("lang.button");
                        color: Theme.text;
                        font-size: 12.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    lang-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppState.toggle-lang();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        property <float> k: Theme.scale > 0.5 ? Theme.scale : 1;
        x: round(232 * self.k) / self.k * 1px;
        y: round(41.5 * self.k) / self.k * 1px;
        width: parent.width - self.x - 24px;
        height: parent.height - self.y - 22.5px;
        HomePage {
            current: Theme.shown-page == 0;
        }
        CleanPage {
            current: Theme.shown-page == 1;
        }
        RegistryPage {
            current: Theme.shown-page == 2;
        }
        StartupPage {
            current: Theme.shown-page == 3;
        }
        UninstallPage {
            current: Theme.shown-page == 4;
        }
        DiskPage {
            current: Theme.shown-page == 5;
        }
        ToolsPage {
            current: Theme.shown-page == 6;
        }
        BackupsPage {
            current: Theme.shown-page == 7;
        }
    }

    TitleBar {
        x: 0px;
        y: 0px;
        width: 100%;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: AppState.dialog-open ? 1 : 0;
        visible: self.opacity > 0.01;
        background: Theme.scrim;
        animate opacity { duration: 200ms; easing: ease-out; }
        TouchArea {
            clicked => {
                AppState.dialog-cancel();
            }
        }
        Rectangle {
            width: min(384px, parent.width - 38.5px);
            height: dl.preferred-height;
            x: (parent.width - self.width) / 2;
            property <length> lift: AppState.dialog-open ? 0px : 19px;
            y: (parent.height - self.height) / 2 + Theme.glide(self.lift / 19px, 19px);
            animate lift { duration: 320ms; easing: spring(0); }
            Rectangle {
                border-radius: 24px;
                background: #00000002;
                drop-shadow-color: Theme.shadow;
                drop-shadow-blur: 40px;
                drop-shadow-offset-y: 16px;
            }
            Sq {
                r: 24;
                colorize: Theme.dialog-bg;
                edge: Theme.card-border;
                edge-width: 1px;
            }
            TouchArea {}
            dl := VerticalLayout {
                padding: 24px;
                padding-bottom: 21px;
                spacing: 9.5px;
                Text {
                    text: AppState.dialog-title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: AppState.dialog-text;
                    color: Theme.text-dim;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 9.5px;
                }
                HorizontalLayout {
                    spacing: 9.5px;
                    alignment: end;
                    if !AppState.dialog-single: SecondaryButton {
                        fade: 1;
                        text: T.s("dialog.cancel");
                        clicked => {
                            AppState.dialog-cancel();
                        }
                    }
                    PrimaryButton {
                        fade: 1;
                        text: AppState.dialog-single ? T.s("dialog.ok") : AppState.dialog-ok;
                        danger: AppState.dialog-danger;
                        clicked => {
                            AppState.dialog-accept();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        opacity: AppState.details-open ? 1 : 0;
        visible: self.opacity > 0.01;
        background: Theme.scrim;
        animate opacity { duration: 200ms; easing: ease-out; }
        TouchArea {
            clicked => {
                AppState.close-details();
            }
        }
        Rectangle {
            width: min(680px, parent.width - 48px);
            height: min(parent.height - 100px, 560px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            SoftShadow {
                corner: 24px;
                blur: 40px;
                dy: 16px;
            }
            Sq {
                r: 24;
                colorize: Theme.dialog-bg;
                edge: Theme.card-border;
                edge-width: 1px;
            }
            TouchArea {}
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                border-radius: 23px;
                background: Theme.dark ? #131a29 : #ffffff;
                opacity: 0.94;
            }
            VerticalLayout {
                padding: 24px;
                padding-bottom: 20px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 14px;
                    Chip {
                        fade: 1;
                        icon: AppState.details-icon;
                        tint: AppState.details-tint;
                        size: 48px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        Text {
                            text: AppState.details-title;
                            color: Theme.text;
                            font-size: 19px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: AppState.details-sub;
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    if AppState.details-total != "": Text {
                        text: AppState.details-total;
                        color: Theme.tint-fg(AppState.details-tint);
                        font-size: 22px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    height: 10px;
                }
                Rectangle {
                    height: 1px;
                    background: Theme.sep;
                }
                Rectangle {
                    height: 6px;
                }
                Rectangle {
                    vertical-stretch: 1;
                    ds := Scroller {
                        width: parent.width;
                        height: parent.height;
                        for r[i] in AppState.details-rows: DetailLine {
                            order: i;
                            shown: self.absolute-position.y + self.height > ds.absolute-position.y && self.absolute-position.y < ds.absolute-position.y + ds.height;
                            item: r;
                        }
                    }
                    if AppState.details-loading: Text {
                        text: T.s("details.loading");
                        color: Theme.text-dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !AppState.details-loading && AppState.details-rows.length == 0: Text {
                        text: T.s("details.empty");
                        color: Theme.text-dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    padding-top: 10px;
                    SecondaryButton {
                        fade: 1;
                        text: T.s("details.close");
                        clicked => {
                            AppState.close-details();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        width: min(440px, parent.width - 300px);
        height: 48px;
        x: (parent.width - self.width) / 2;
        property <length> lift: AppState.toast-open ? 0px : 80px;
        y: 18px - Theme.snap(self.lift);
        opacity: AppState.toast-open ? 1 : 0;
        animate lift { duration: 320ms; easing: spring(0.1); }
        animate opacity { duration: 220ms; }
        visible: self.lift < 79px;
        SoftShadow {
            corner: 24px;
            blur: 24px;
            dy: 8px;
        }
        Rectangle {
            border-radius: 24px;
            background: Theme.dialog-bg;
            border-width: 1px;
            border-color: Theme.card-border;
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 22px;
            spacing: 11px;
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: Theme.ok-soft;
                y: (parent.height - self.height) / 2;
                Icon {
                    kind: "check";
                    size: 14px;
                    colorize: Theme.ok;
                }
            }
            Text {
                text: AppState.toast-text;
                color: Theme.text;
                font-size: 13px;
                font-weight: Theme.semi;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    }

    Backdrop {
        veil: true;
        opacity: 1 - Theme.content-opacity;
        visible: Theme.content-opacity < 0.999;
    }

    Image {
        width: 100%;
        height: 100%;
        source: Theme.fade-image;
        opacity: Theme.fade-opacity;
        visible: Theme.fade-opacity > 0.001;
    }

    ResizeEdges {
        width: 100%;
        height: 100%;
    }
}
