import { Theme, T } from "../theme.slint";
import { Chip, SecondaryButton, ListGroup, Toggle } from "../widgets.slint";
import { PageFrame, PageHead } from "common.slint";
import { Intro, Rise } from "../motion.slint";

export struct ToolItem {
    id: string,
    title: string,
    desc: string,
    state: string,
    icon: string,
    tint: int,
    toggle: bool,
    on: bool,
    busy: bool,
    locked: bool,
}

export global ToolsState {
    in-out property <[ToolItem]> items: [];
    callback switched(string, bool);
    callback run(string);
}

component ToolRow inherits Rise {
    in property <ToolItem> item;
    in property <bool> last: false;
    height: 78px;

    if !root.last: Rectangle {
        x: 68px;
        y: parent.height - 1px;
        width: parent.width - 68px - 14px;
        height: 1px;
        background: Theme.sep.transparentize(1 - root.v);
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 13px;
        Chip {
            fade: root.v;
            icon: root.item.icon;
            tint: root.item.tint;
            size: 37px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                opacity: root.v;
                text: root.item.title;
                color: Theme.text;
                font-size: 13.5px;
                font-weight: Theme.semi;
                overflow: elide;
            }
            Text {
                opacity: root.v;
                text: root.item.desc;
                color: Theme.text-dim;
                font-size: 11px;
                wrap: word-wrap;
                max-height: 32px;
                overflow: elide;
            }
        }
        if root.item.state != "": Text {
            opacity: root.v;
            text: root.item.state;
            color: Theme.text-dim;
            font-size: 11.5px;
            width: 96px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.item.toggle: Toggle {
            fade: root.v;
            on: root.item.on;
            enabled: !root.item.busy && !root.item.locked;
            y: (parent.height - self.height) / 2;
            toggled(v) => {
                ToolsState.switched(root.item.id, v);
            }
        }
        if !root.item.toggle: SecondaryButton {
            fade: root.v;
            text: T.s("tools.btn");
            height: 32px;
            enabled: !root.item.busy;
            y: (parent.height - self.height) / 2;
            clicked => {
                ToolsState.run(root.item.id);
            }
        }
    }
}

export component ToolsPage inherits PageFrame {
    VerticalLayout {
        spacing: 14.5px;
        PageHead {
            title: T.s("tools.title");
            sub: T.s("tools.sub");
        }
        Rectangle {
            vertical-stretch: 1;
            ListGroup {
                limit: parent.height;
                width: parent.width;
                for item[i] in ToolsState.items: ToolRow {
                    order: i;
                    item: item;
                    last: i == ToolsState.items.length - 1;
                }
            }
        }
    }
}
